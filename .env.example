# Venice AI credentials are read only by the local Node server.
# Never prefix these with VITE_ or they will be shipped to the browser.
VENICE_API_KEY=your_venice_inference_key
VENICE_MODEL=venice-uncensored
PORT=5173

# Modal / Z-Image-Turbo scene illustrator
SCENE_IMAGE_URL=https://avijitpalit3--z-image-turbo-zimageservice-fastapi-app.modal.run/generate
SCENE_IMAGE_WIDTH=720
SCENE_IMAGE_HEIGHT=1280
SCENE_IMAGE_STEPS=9

# Optional second image provider: RunPod Z-Image-Turbo
RUNPOD_API_KEY=your_runpod_api_key
RUNPOD_ZIMAGE_ENDPOINT=https://api.runpod.ai/v2/z-image-turbo
RUNPOD_TIMEOUT_MS=48000

# Optional third image provider: Venice AI image generation (same Venice key)
VENICE_IMAGE_MODEL=z-image-turbo
VENICE_IMAGE_URL=https://api.venice.ai/api/v1/images/generations
